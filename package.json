{
  "name": "honobackend",
  "version": "1.0.0",
  "description": "Hono/TypeScript backend API with PostgreSQL and Drizzle ORM",
  "module": "index.ts",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "dev": "bun --hot index.ts",
    "start": "bun run index.ts",
    "build": "tsc --noEmit && bun build index.ts --minify --outdir dist --target bun",
    "build:compile": "tsc --noEmit && bun build index.ts --minify --outfile bin/honobackend --compile --target bun",
    "start:prod": "bun run dist/index.js",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "test:coverage": "bun test --coverage",
    "clean": "node -e \"['dist','bin'].forEach(d=>{try{require('fs').rmSync(d,{recursive:true,force:true})}catch{}})\"",
    "format": "oxfmt --write \"src/**/*.ts\"",
    "format:check": "oxfmt --check \"src/**/*.ts\""
  },
  "dependencies": {
    "@hono/zod-validator": "^0.9.0",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.5",
    "hono-rate-limiter": "^0.5.3",
    "postgres": "^3.4.9",
    "redis": "^6.2.1",
    "resend": "^6.25.0",
    "sanitize-html": "^2.17.7",
    "zod": "^4.5.2"
  },
  "devDependencies": {
    "@types/bun": "^1.4.0",
    "@types/sanitize-html": "^2.16.1",
    "drizzle-kit": "^0.31.10",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "typescript": "^7.0.2"
  },
  "keywords": [
    "hono",
    "typescript",
    "backend",
    "api",
    "postgresql",
    "drizzle-orm",
    "bun"
  ],
  "author": "pilput",
  "license": "MIT"
}
